{
  "name": "bibliopolis",
  "version": "0.1.0",
  "main": "main.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node --enable-source-maps ./dist/main.js",
    "start:dev": "nodemon --watch src --ext ts --exec \"echo -- compiling -- && pnpm run --silent build && echo -- starting -- && pnpm run --silent start\"",
    "lint": "ts-standard",
    "lint:fix": "ts-standard --fix",
    "seed": "node ./dist/scripts/seed.js",
    "enrich-isbn10": "node ./dist/scripts/enrich-isbn10.js",
    "test": "ENVIRONMENT='test' JWT_ACCESS_TOKEN_SECRET='test' vitest run --pool=forks --reporter=verbose",
    "test:dev": "pnpm run --silent build && ENVIRONMENT='test' JWT_ACCESS_TOKEN_SECRET='test' vitest run --pool=forks --reporter=verbose",
    "test:unit": "ENVIRONMENT='test' JWT_ACCESS_TOKEN_SECRET='test' vitest run --config=vitest.config.unit.ts --reporter=verbose",
    "test:unit:dev": "pnpm run --silent build && ENVIRONMENT='test' JWT_ACCESS_TOKEN_SECRET='test' vitest run --config=vitest.config.unit.ts --reporter=verbose",
    "test:integration": "ENVIRONMENT='test' JWT_ACCESS_TOKEN_SECRET='test' vitest run --config=vitest.config.integration.ts --pool=forks --reporter=verbose",
    "test:integration:dev": "pnpm run --silent build && ENVIRONMENT='test' JWT_ACCESS_TOKEN_SECRET='test' vitest run --config=vitest.config.integration.ts --pool=forks --reporter=verbose",
    "test:coverage": "ENVIRONMENT='test' JWT_ACCESS_TOKEN_SECRET='test' vitest run --coverage",
    "version:patch": "pnpm version patch",
    "version:minor": "pnpm version minor",
    "version:major": "pnpm version major",
    "docs:dev": "mkdocs serve -a 127.0.0.1:8001"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.7.1",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.5",
    "@vitest/coverage-v8": "3.1.1",
    "@vitest/ui": "^3.1.1",
    "nodemon": "^3.1.7",
    "ts-standard": "^12.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.6.2",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.9.0",
    "mongodb-memory-server": "^10.0.1",
    "multer": "^2.5.0",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.17.2",
    "ulid": "^2.3.0",
    "winston": "^3.15.0",
    "zod": "^3.23.8"
  },
  "eslintConfig": {
    "extends": [
      "./node_modules/ts-standard/eslintrc.json"
    ],
    "parserOptions": {
      "project": [
        "./tsconfig.eslint.json"
      ]
    }
  },
  "ts-standard": {
    "ignore": [
      "dist",
      "vitest.config.ts"
    ]
  }
}
