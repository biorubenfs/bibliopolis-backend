# Copy this file to .env. Empty values count as missing: the app refuses to start
# if a required variable is absent and lists every problem at once (see src/config.ts).

# local | dev | production | test
ENVIRONMENT=local

# Port the app listens on. In Docker it must stay 3000: the compose files publish host:3000
PORT=3000

# Required. Needs a replica set (transactions are used)
MONGO_URI=mongodb://localhost:27018/bibliopolis

# Required. Created on the first start if no user has that email
DEFAULT_ADMIN_NAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me

# Required. Use a long random string, different per environment
JWT_ACCESS_TOKEN_SECRET=lkhaspday9d813hnlkahnsd9as78d0ahslkanfa
JWT_EXPIRATION=7d

HASH_ROUNDS=10

OPEN_LIBRARY_DOMAIN=https://openlibrary.org
OPEN_LIBRARY_COVER_URL_PATTERN=https://covers.openlibrary.org/b/id/:id-:size.jpg

GOOGLE_BOOKS_DOMAIN=https://www.googleapis.com
GOOGLE_BOOKS_COVER_URL_PATTERN=http://books.google.com/books/content?id=:id&printsec=frontcover&img=1&zoom=:size
GOOGLE_BOOKS_API_KEY=

ROBO_HASH_API_BASE_URL=https://robohash.org

# Origin of the frontend, with scheme and without trailing slash. In production it must be https://
CORS_ORIGIN=http://localhost:4200

# true | false
DEBUG_STACK_TRACE=false
